# Copiar a .env.local y completar. Nunca subir valores reales al repositorio.

# URL pública del sitio, sin barra final (ej. https://dominio). Pendiente P-001.
NEXT_PUBLIC_SITE_URL=

# WooCommerce del sitio actual (Store API pública y página de pago).
WOO_STORE_API_URL=
WOO_CHECKOUT_URL=

# Correo transaccional (Resend) y destino de los avisos de formularios.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# Números de WhatsApp por unidad, en formato internacional (ej. 18095551234).
NEXT_PUBLIC_WHATSAPP_VENTAS=
NEXT_PUBLIC_WHATSAPP_CONSULTORIO=
NEXT_PUBLIC_WHATSAPP_ENTRENAMIENTO=

# Analítica.
NEXT_PUBLIC_ANALYTICS_ID=

# Cloudflare Turnstile (anti-spam de formularios).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Solo el día del lanzamiento: "si". Activa ocultar borradores, indexación y que un {{PENDIENTE}} rompa el build (D-008).
HUMAN_LANZAMIENTO=
